{
  "name": "the-ellison-group",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build && node scripts/check-build.mjs",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "lighthouse": "lhci autorun",
    "seed": "node scripts/seed.mjs",
    "setup": "node scripts/setup.mjs",
    "prepare": "husky",
    "db:types": "supabase gen types typescript --local > lib/supabase/database.types.ts"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,json,css,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/geist": "5.3.0",
    "@hookform/resolvers": "6.0.1",
    "@radix-ui/react-accordion": "1.3.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@react-email/components": "1.0.12",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "@vercel/analytics": "2.0.1",
    "ai": "7.0.156",
    "clsx": "2.1.1",
    "framer-motion": "14.7.1",
    "gsap": "3.15.0",
    "lenis": "1.3.27",
    "lucide-react": "1.62.0",
    "maplibre-gl": "6.16.0",
    "next": "15.5.28",
    "nuqs": "2.10.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "7.91.0",
    "resend": "6.35.0",
    "supercluster": "9.1.0",
    "tailwind-merge": "3.7.0",
    "terra-draw": "1.38.0",
    "terra-draw-maplibre-gl-adapter": "1.5.0",
    "twilio": "6.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/eslintrc": "3.3.7",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supercluster": "7.1.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.28",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "supabase": "2.122.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "5.0.5"
  }
}
