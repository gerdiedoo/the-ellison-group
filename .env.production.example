# Public values are embedded at image build time. Rebuild after changing them.
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_DATA_MODE=mock
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_INTERNAL_URL=
# Server secrets. Never use NEXT_PUBLIC_ for these.
SUPABASE_SERVICE_ROLE_KEY=
AUTH_SECRET=local-prototype-only-replace-before-hosting-with-32-random-bytes
DEMO_ADMIN_CODE=prototype-admin
JOB_SECRET=local-jobs-only-replace-before-hosting
NEXT_PUBLIC_MAP_STYLE_URL=
MAP_API_KEY=
GEOCODING_API_KEY=
RESEND_API_KEY=
LEADS_NOTIFY_EMAIL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_GTM_ID=
IDX_FEED_URL=
IDX_FEED_TOKEN=
WALKSCORE_API_KEY=
YELP_API_KEY=
CENSUS_API_KEY=
GIT_SHA=local
SITE_DOMAIN=localhost
# Live mode requires provider keys, Turnstile, a strong AUTH_SECRET, and Supabase.
DELIVERY_MODE=log

